{
  "name": "fastmemo-app-new-arch",
  "main": "expo-router/entry",
  "version": "3.1.1",
  "scripts": {
    "start": "expo start",
    "start:clear-cache": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios-build": "eas build -p ios",
    "ios-build:submit": "eas build -p ios --auto-submit",
    "android-build:dev": "eas build -p android --profile development",
    "android-build:preview": "eas build -p android --profile preview",
    "android-build:prod": "eas build -p android --profile production",
    "web": "expo start --web",
    "tauri:dev": "tauri dev",
    "tauri:build": "dotenv -e .env -- tauri build",
    "tauri:build:mac": "dotenv -e .env -- tauri build --target universal-apple-darwin",
    "tauri:build:windows": "dotenv -e .env -- tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:linux": "dotenv -e .env -- tauri build --target x86_64-unknown-linux-gnu",
    "tauri:build:test": "dotenv -e .env -- tauri build -c src-tauri/tauri.test.conf.json",
    "tauri:build:test:mac": "dotenv -e .env -- tauri build --target universal-apple-darwin -c src-tauri/tauri.test.conf.json",
    "tauri:build:test:windows": "dotenv -e .env -- tauri build --target x86_64-pc-windows-msvc -c src-tauri/tauri.test.conf.json",
    "tauri:build:test:linux": "dotenv -e .env -- tauri build --target x86_64-unknown-linux-gnu -c src-tauri/tauri.test.conf.json",
    "format": "prettier --write \"./src/**/*.{ts,tsx,js,jsx,md,json}\"",
    "format:diff": "prettier --write $(git diff --name-only | grep '.ts\\|.tsx\\|.js\\|.json\\|.md')",
    "lint": "expo lint",
    "clean:projects": "rm -rf android ios dist",
    "clean:all": "rm -rf node_modules .expo android ios .expo-shared .eas dist",
    "build:editor": "node scripts/build-codemirror.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
