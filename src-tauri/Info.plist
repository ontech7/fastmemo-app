<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A self-hosted server on plain http:// under a name (nas.home.arpa, a DDNS name): App Transport Security only lets
	     the webview reach IP addresses, localhost and .local names over http otherwise. The app warns before using HTTP
	     (ADR-017). -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
	</dict>
</dict>
</plist>
